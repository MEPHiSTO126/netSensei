{
  "name": "netsensei-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/dev/check_manifest.mjs && node scripts/dev/check_migrations.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:with-demo-users": "tsx prisma/seed.ts --with-demo-users",
    "db:seed:production": "tsx prisma/seed.ts --production",
    "db:reset:content": "tsx scripts/dev/reset_course_content.mts --content --confirm DELETE-CONTENT",
    "db:reset:student": "tsx scripts/dev/reset_course_content.mts --progress",
    "content:apply": "npm run db:seed:production",
    "content:quiz-keys": "tsx scripts/dev/apply_quiz_content.mts",
    "content:css": "node scripts/build-css-extra.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
