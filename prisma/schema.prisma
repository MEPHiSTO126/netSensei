generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  role      String   @default("STUDENT")
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  answerRecords      AnswerRecord[]
  snippetAttempts    SnippetAttempt[]
  tutorSessionsAsStudent TutorSession[] @relation("StudentSessions")
  tutorSessionsAsTutor   TutorSession[] @relation("TutorSessions")
  messages           Message[]
  tutorRequests      TutorRequest[]
  progressRecords    ProgressRecord[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  modules     Module[]
  progressRecords ProgressRecord[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  order     Int      @default(0)
  description String?
  phases    Phase[]
}

model Phase {
  id        String   @id @default(cuid())
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  title     String
  order     Int      @default(0)
  description String?
  stages    Stage[]
  quiz      Quiz?
  progressRecords ProgressRecord[]
}

model Stage {
  id          String    @id @default(cuid())
  phaseId     String
  phase       Phase     @relation(fields: [phaseId], references: [id])
  title       String
  type        String
  content     String
  order       Int       @default(0)
  imageUrl    String?
  tutorRequests TutorRequest[]
}

model Quiz {
  id            String   @id @default(cuid())
  phaseId       String   @unique
  phase         Phase    @relation(fields: [phaseId], references: [id])
  mode          String   @default("NORMAL")
  passThreshold Int      @default(70)
  questions     Question[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  type        String
  language    String   @default("javascript")
  prompt      String
  fullGoal    String?
  expectedAnswer String?
  rubric      String?
  order       Int      @default(0)
  points      Int      @default(1)
  answerRecords AnswerRecord[]
  snippetAttempts SnippetAttempt[]
}

model SnippetAttempt {
  id        String   @id @default(cuid())
  questionId String
  question  Question @relation(fields: [questionId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  code      String
  language  String
  aiFeedback String?
  score     Int?
  createdAt DateTime @default(now())
}

model AnswerRecord {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  content     String
  type        String
  score       Int?
  aiFeedback  String?
  attemptNumber Int    @default(1)
  createdAt   DateTime @default(now())
}

model TutorSession {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentSessions", fields: [studentId], references: [id])
  tutorId      String?
  tutor        User?    @relation("TutorSessions", fields: [tutorId], references: [id])
  mode         String   @default("LIVE")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  endedAt      DateTime?
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  type      String   @default("TEXT")
  stageId   String?
  createdAt DateTime @default(now())
}

model TutorRequest {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id])
  question  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  answeredAt DateTime?
}

model ProgressRecord {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  phaseId   String
  phase     Phase    @relation(fields: [phaseId], references: [id])
  score     Int
  passed    Boolean  @default(false)
  attemptNumber Int  @default(1)
  completedAt DateTime @default(now())
}
